    "url": "https://github.com/cyreslab/nist-nvd-mcp-server/issues"
  },
  "homepage": "https://github.com/cyreslab/nist-nvd-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
