{
  "name": "@cyreslab/nist-nvd-mcp-server",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP server for accessing NIST NVD (National Vulnerability Database) API - search CVE data, vulnerabilities, and security information",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "nist-nvd-mcp-server": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "ts-node src/index.ts",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nist",
